            delfile("AutoBounty.file")
        end
    end

    if _G.LowVisualMode then
        _G.SetLowVisualState(true)
    end

    if _G.RemoveFogEnabled then
        _G.ApplyRemoveFog()
    end

    if setfpscap then
        if _G.UnlockFPS then
