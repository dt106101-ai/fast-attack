        State.M1_RegisterAttack = RegAttack
        State.M1_RegisterHit = RegHit
        State.M1_Enemies = Enemies
        return Remotes, NetInstance, RegAttack, RegHit, Enemies
    end
    return nil, nil, nil, nil, nil
