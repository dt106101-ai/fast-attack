-- 快捷鍵聯動 (G 穿牆, F 飛行)
UserInputService.InputBegan:Connect(function(input, processed)
    if processed then return end
    if input.KeyCode == Enum.KeyCode.G then
        _G.NoClip = not _G.NoClip
        NoClipToggle:Set(_G.NoClip)
    elseif input.KeyCode == Enum.KeyCode.F then
        _G.BoatFlyActive = not _G.BoatFlyActive
        FlyToggle:Set(_G.BoatFlyActive)
    end
end)

RunService.Heartbeat:Connect(function()
    local char = LP.Character
    if not char then return end
    local hum = char:FindFirstChildOfClass("Humanoid")

    -- 航海核心邏輯
    if hum and hum.SeatPart and hum.SeatPart:IsA("VehicleSeat") then
        local seat = hum.SeatPart
        local boat = seat.Parent
        
        -- 物理加速同步
        if _G.BoatSpeedActive then seat.MaxSpeed = _G.BoatSpeedValue else seat.MaxSpeed = 80 end

        -- 座標強推位移
        if _G.BoatAutoCruise or _G.BoatFlyActive then
            local currentCF = boat:GetPivot()
            local nextCF = currentCF
            if _G.BoatAutoCruise then
                nextCF = nextCF * CFrame.new(0, 0, -2.5) -- 防回溯步長
            end
            local finalY = _G.BoatFlyActive and _G.BoatFlyHeight or currentCF.Position.Y
            boat:PivotTo(CFrame.new(nextCF.Position.X, finalY, nextCF.Position.Z) * nextCF.Rotation)
            
            for _, p in pairs(boat:GetDescendants()) do
                if p:IsA("BasePart") then p.Velocity = Vector3.zero; p.RotVelocity = Vector3.zero end
            end
        end
    end

    -- 玩家基礎核心
    if _G.CatSpeedActive and hum and hum.MoveDirection.Magnitude > 0 then
        char:TranslateBy(hum.MoveDirection * (_G.CatSpeedValue / 10))
    end
    if _G.AutoV3 then
        VIM:SendKeyEvent(true, Enum.KeyCode.T, false, game); task.wait(0.01); VIM:SendKeyEvent(false, Enum.KeyCode.T, false, game)
    end
    if _G.AutoV4 then
        local awake = LP.Backpack:FindFirstChild("Awakening") or char:FindFirstChild("Awakening")
        if awake then awake.RemoteFunction:InvokeServer(true) end
    end
    if _G.AutoBuso and not char:FindFirstChild("HasBuso") then
        ReplicatedStorage.Remotes.CommF_:InvokeServer("Buso")
    end
    if _G.EnergyValue and char:FindFirstChild("Energy") then char.Energy.Value = _G.EnergyValue end
end)

